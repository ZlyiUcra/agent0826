# Скопіюйте у .env і підставте свій ключ
ANTHROPIC_API_KEY=sk-ant-...

# Необовʼязково
ANTHROPIC_MODEL=claude-sonnet-4-6
MAX_TOKENS=1200
MAX_TURNS=6

# ── Qdrant: сховище векторів у Docker ────────────────────────
# Практика працює і без нього: якщо сервера немає, пошук іде по документах
# у practice/docs/ з матрицею в пам'яті. Якщо сервер є — вектори беруться з
# нього, а за потреби туди ж і заливаються.
#
# Підняти сервер (з будь-якої теки):
#   docker run -d --name agent0826-qdrant -p 6333:6333 -p 6334:6334 \
#       -v agent0826-qdrant:/qdrant/storage qdrant/qdrant
# Наявний контейнер піднімається коротше:
#   docker start agent0826-qdrant
# Те саме вміє сама практика:
#   python -m practice.challenges.qdrant_store --up
QDRANT_URL=http://localhost:6333
QDRANT_CONTAINER=agent0826-qdrant
QDRANT_VOLUME=agent0826-qdrant
QDRANT_IMAGE=qdrant/qdrant

# Що робити, коли сервер є, а потрібних векторів у ньому ще немає:
#   ask — показати обсяг і вільне місце та спитати дозволу (типово);
#   1   — згода дана наперед, заливати мовчки;
#   0   — не заливати ніколи, лишатися на документах.
# Прогін без термінала нікого не питає: там ask означає «ні» плюс команда,
# якою заливання робиться свідомо.
QDRANT_AUTO_INGEST=ask

# Яке сховище брати: auto — Qdrant, якщо доступний, інакше документи;
# vector — завжди документи; qdrant — тільки Qdrant, без запасного шляху;
# lexical — пошук по словах (BM25), без ембедингів.
PRACTICE_RETRIEVER=auto

# Який набір документів: core — вісімнадцять розділів навколо sec-object-type,
# full — уся специфікація з practice/docs-full/.
PRACTICE_DOCS=full
